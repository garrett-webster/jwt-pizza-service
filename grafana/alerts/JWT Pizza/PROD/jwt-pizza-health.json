        "__dashboardUid__": "jwt-pizza-prod-pizza-dashboard",
        "__panelId__": "4"
      },
      "labels": {
        "service": "jwt-pizza-service",
        "severity": "warning"
      },
      "notification_settings": {
        "receiver": "JWT Pizza DevOps Contact"
      },
      "isPaused": false
    },
    {
      "uid": "jwt-pizza-memory",
      "title": "Memory above 90%",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
