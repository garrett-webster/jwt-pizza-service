          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "datasource": {
