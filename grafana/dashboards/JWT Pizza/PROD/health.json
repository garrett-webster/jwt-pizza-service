                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (type) (count_over_time({component=\"jwt-pizza-service\", level=\"error\"}[1m]))",
